# ============================================================
# LOAD DATA
# ============================================================

BASE_DIR = Path(__file__).resolve().parent
DATA_DIR = BASE_DIR / "data"


@st.cache_data
def load_xlsb(filename, sheet_name=None):

    file_path = DATA_DIR / filename

    return pd.read_excel(
        file_path,
        sheet_name=sheet_name,
        engine="pyxlsb"
    )


@st.cache_data
def load_all_data():

    loans = load_xlsb("loans.xlsb", "loans")

    customers = load_xlsb(
        "customers.xlsb",
        "customers"
    )

    accounts = load_xlsb(
        "accounts.xlsb",
        "accounts"
    )

    transactions = load_xlsb(
        "transactions.xlsb",
        "transactions"
    )

    tickets = load_xlsb(
        "support tickets.xlsb",
        "support tickets"
    )

    return (
        loans,
        customers,
        accounts,
        transactions,
        tickets
    )


try:

    (
        loans,
        customers,
        accounts,
        transactions,
        tickets
    ) = load_all_data()

except Exception as e:

    st.error(
        "Unable to load the banking datasets."
    )

    st.exception(e)

    st.stop()


