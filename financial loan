# LOAN SIMULATOR
# ============================================================

elif page == "Loan Simulator":

    st.header(
        "🧮 Loan EMI & Risk Simulator"
    )


    col1, col2 = st.columns(2)


    with col1:

        loan_type = st.selectbox(
            "Loan Type",
            sorted(
                loans[
                    "loan_type"
                ].dropna().unique()
            )
        )


        amount = st.number_input(
            "Loan Amount (₹)",
            min_value=10000.0,
            value=float(
                loans[
                    "loan_amount"
                ].median()
            )
        )


        rate = st.number_input(
            "Interest Rate (%)",
            min_value=0.0,
            max_value=50.0,
            value=float(
                loans[
                    "interest_rate"
                ].median()
            )
        )


        tenure = st.number_input(
            "Tenure (Months)",
            min_value=3,
            max_value=360,
            value=60
        )


    with col2:

        age = st.number_input(
            "Customer Age",
            min_value=18,
            max_value=90,
            value=35
        )


        income = st.number_input(
            "Annual Income (₹)",
            min_value=50000.0,
            value=float(
                customers[
                    "annual_income"
                ].median()
            )
        )


    if st.button(
        "Calculate EMI",
        type="primary"
    ):

        monthly_rate = (
            rate / 100 / 12
        )


        if monthly_rate == 0:

            emi = amount / tenure

        else:

            emi = (
                amount
                * monthly_rate
                * (1 + monthly_rate) ** tenure
                /
                (
                    (1 + monthly_rate)
                    ** tenure - 1
                )
            )


        total_payment = (
            emi * tenure
        )


        interest = (
            total_payment
            - amount
        )


        c1, c2, c3 = st.columns(3)


        c1.metric(
            "Monthly EMI",
            f"₹{emi:,.0f}"
        )


        c2.metric(
            "Total Payment",
            f"₹{total_payment:,.0f}"
        )


        c3.metric(
            "Total Interest",
            f"₹{interest:,.0f}"
        )


        st.info(
            "EMI is an illustrative calculation and "
            "does not represent an actual bank offer."
        )


# ============================================================
# AI FINANCIAL ASSISTANT
# ============================================================

elif page == "AI Financial Assistant":

    st.header(
        "💬 Financial AI Assistant"
    )


    question = st.text_input(
        "Ask a question about the loan portfolio",
        placeholder=
        "Example: Which loan type has the highest default rate?"
    )


    if question:

        q = question.lower()


        if (
            "default rate"
            in q
        ):

            rate = (
                loans[
                    "loan_status"
                ]
                .eq("Default")
                .mean()
                * 100
            )


            st.success(
                f"The observed portfolio default rate is "
                f"**{rate:.2f}%**."
            )


        elif (
            "highest"
            in q
            and "default"
            in q
        ):

            result = (
                loans.assign(
                    default_flag=
                    loans[
                        "loan_status"
                    ]
                    .eq("Default")
                    .astype(int)
                )
                .groupby(
                    "loan_type"
                )
                ["default_flag"]
                .mean()
                .sort_values(
                    ascending=False
                )
            )


            st.success(
                f"**{result.index[0]}** has the highest "
                f"observed default rate of "
                f"**{result.iloc[0] * 100:.2f}%**."
            )


        elif (
            "average interest"
            in q
        ):

            st.success(
                f"The average interest rate is "
                f"**{loans['interest_rate'].mean():.2f}%**."
            )


        elif (
            "total loan"
            in q
        ):

            st.success(
                f"The total loan portfolio is "
                f"**₹{loans['loan_amount'].sum():,.0f}**."
            )


        elif (
            "active"
            in q
        ):

            count = (
                loans[
                    "loan_status"
                ]
                .eq("Active")
                .sum()
            )


            st.success(
                f"There are **{count:,} active loans**."
            )


        else:

            st.info(
                "Try questions such as: "
                "What is the default rate? "
                "Which loan type has the highest default? "
                "What is the total loan portfolio? "
                "What is the average interest rate?"
            )


