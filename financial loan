    customers,
    on="customer_id",
    how="left"
)


# ============================================================
# SIDEBAR
# ============================================================

st.sidebar.title("📊 Navigation")

page = st.sidebar.radio(
    "Select Dashboard",
    [
        "Executive Dashboard",
        "Loan Risk Analysis",
        "Customer Analysis",
        "Loan Simulator",
